# --- LLM provider (generation) -------------------------------------------------------------
# Unprefixed, like the SDKs' own variables: src/generation/llm.py reads these first and falls
# back to the DOCQA_-prefixed defaults in src/common/config.py.
# Priority: Azure OpenAI (key + endpoint set) > local server > plain OpenAI.

# Default: a local OpenAI-compatible server (Ollama). No API key, no cost.
# `ollama pull qwen2.5:7b-instruct` — any instruction-following model works; tool calling isn't needed.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_API_KEY=not-needed

# Azure OpenAI: used when both the key and the endpoint are set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Plain OpenAI: used only when Azure isn't configured and LOCAL_LLM_BASE_URL is set to empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Ingestion / retrieval overrides (optional; these are the defaults) --------------------
DOCQA_CHUNK_SIZE_TOKENS=450   # embedding-model tokens; must fit the 512-token window
DOCQA_CHUNK_OVERLAP_TOKENS=50
DOCQA_DEFAULT_TOP_K=5
DOCQA_RRF_K=60                # reciprocal rank fusion constant
DOCQA_HYBRID_CANDIDATES=20    # candidates each retriever contributes before fusion
DOCQA_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Re-ranking (hybrid_rerank mode only) -------------------------------------------------
DOCQA_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCQA_RERANK_CANDIDATES=20    # fused candidates re-scored by the cross-encoder
DOCQA_RERANK_MIN_SCORE=0.2    # relevance floor; below it the agent abstains
