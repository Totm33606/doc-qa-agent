# --- LLM provider for generation (pick one, or leave as-is for the default) --------------
# Note the two naming conventions below, and which wins. Everything under
# "Ingestion / retrieval overrides" is read by src/common/config.py and so takes the
# DOCQA_ prefix. The LLM provider vars are deliberately *unprefixed*: src/generation/llm.py
# reads them directly, so they match what the underlying SDKs and the finrisk-agent sibling
# project already use. The DOCQA_-prefixed spellings of the LLM settings also exist, but
# they only supply the default — an unprefixed var beats them when both are set.
# Default: a local, OpenAI-API-compatible server — Ollama by default. No API key, no cost.
# `ollama pull qwen2.5:7b-instruct` (or any other tool-calling-capable model) to get started.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_API_KEY=not-needed

# Option B: Azure OpenAI (used automatically if both vars below are set — takes priority
# over the local server)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Option C: plain OpenAI (only used if LOCAL_LLM_BASE_URL is explicitly cleared and Azure
# is not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Ingestion / retrieval overrides (optional, all have sane defaults) -------------------
DOCQA_CHUNK_SIZE_TOKENS=500
DOCQA_CHUNK_OVERLAP_TOKENS=50
DOCQA_DEFAULT_TOP_K=5
DOCQA_RRF_K=60                # reciprocal-rank-fusion constant for hybrid retrieval
DOCQA_HYBRID_CANDIDATES=20    # candidates each retriever contributes before fusion
DOCQA_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Re-ranking (hybrid_rerank mode only) -------------------------------------------------
DOCQA_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCQA_RERANK_CANDIDATES=20    # fused candidates re-scored by the cross-encoder
DOCQA_RERANK_MIN_SCORE=0.2    # relevance floor; below it the agent abstains instead of answering
