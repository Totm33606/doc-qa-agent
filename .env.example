# --- LLM provider for generation (pick one, or leave as-is for the default) --------------
# Default: a local, OpenAI-API-compatible server — Ollama by default. No API key, no cost.
# `ollama pull qwen2.5:7b-instruct` (or any other tool-calling-capable model) to get started.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_API_KEY=not-needed

# Option B: Azure OpenAI (used automatically if both vars below are set — takes priority
# over the local server)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Option C: plain OpenAI (only used if LOCAL_LLM_BASE_URL is explicitly cleared and Azure
# is not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Ingestion / retrieval overrides (optional, all have sane defaults) -------------------
DOCQA_CHUNK_SIZE_TOKENS=500
DOCQA_CHUNK_OVERLAP_TOKENS=50
DOCQA_DEFAULT_TOP_K=5
DOCQA_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
